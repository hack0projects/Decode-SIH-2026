# ─────────────────────────────────────────────────────────────────────────────
# CodeSeekho Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Google Gemini API Key (LLM — script generation)
# Get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL
# Found at: Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (NOT anon — service role can upload to storage)
# Found at: Project Settings → API → service_role secret
SUPABASE_KEY=your_supabase_service_role_key_here

# Server Port
PORT=3001

# Absolute path to the Remotion frontend project root (contains src/Root.jsx)
REMOTION_PROJECT_PATH=C:\Users\Sribendu Prasad\OneDrive\Desktop\SIH VIDEO GENERATION

# ── OPTIONAL — AI Voice (ElevenLabs) ─────────────────────────────────────────
# Upgrade from edge-tts to human-quality AI voice.
# Free tier: 10,000 characters/month (~30-40 short videos)
# Get free at: https://elevenlabs.io → Profile → API Keys
# If not set: system falls back to edge-tts automatically
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── OPTIONAL — Groq (Backup LLM) ─────────────────────────────────────────────
# Auto-used when Gemini is rate-limited or down.
# Free: unlimited (rate limited). Models: Llama 3.3 70B, Mixtral, Gemma
# Get free at: https://console.groq.com → API Keys
# If not set: only Gemini is used
GROQ_API_KEY=your_groq_api_key_here

# ── OPTIONAL — HuggingFace (Extra AI models) ─────────────────────────────────
# Backup for various AI tasks. 30,000+ free models.
# Get free at: https://huggingface.co → Settings → Access Tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here